@startuml 03-uvedomleniya-kontrol
' Лаб. 5: классы проектирования. Уведомления МВД, контроль сроков, напоминания
' Тема 7 «Действия после получения патента». Репозиторий: https://github.com/mflkee/fms-course
' Проверка: plantuml -checkonly 03-uvedomleniya-kontrol.puml ; рендер: plantuml -tpng 03-uvedomleniya-kontrol.puml

title Лаб. 5. Уведомления МВД, контроль сроков, напоминания (операции 6–10)

hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #4A6FA5
  ArrowColor #333333
  HeaderBackgroundColor #EAF0F8
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C9B458
}
skinparam nodesep 22
skinparam ranksep 45
top to bottom direction

class "ЭкранУведомленияМВД" as EU <<boundary>> {
  -выбранныйКанал : КаналУведомления
  +показатьПроект(проект : ПроектУведомления)
  +выбратьКанал(канал : КаналУведомления)
  +подтвердитьОтправку(подтверждение : ПодтверждениеОтправки)
  +показатьДоказательства(уведомление : УведомлениеМВД)
  +сообщитьОВозврате(причина : Основание, документВозврата :\nДокумент)
}

class "ЭкранНапоминаний" as EN <<boundary>> {
  -настройки : НастройкиНапоминаний
  +выбратьКаналы(каналы : КаналУведомления[1..*])
  +указатьМоменты(моменты : МоментНапоминания[1..*])
  +подтвердитьСогласие(согласие : Признак)
  +показатьРасписание(напоминания : Напоминание[0..*])
}

class "СервисУведомлений" as SU <<control>> {
  -правилаФормирования : ПравилаУведомления
  +направить(идДоговора : Идентификатор, канал :\nКаналУведомления) : УведомлениеМВД
  +зафиксироватьВозврат(идУведомления : Идентификатор,\nдокументВозврата : Документ)
  -сформироватьПроект(идДоговора : Идентификатор) :\nПроектУведомления
  -выбратьОрган(идДоговора : Идентификатор) :\nТерриториальныйОрганМВД
  -сохранитьДоказательства(уведомление : УведомлениеМВД)
}

class "МодульКонтроляСроков" as MKS <<control>> {
  -срокТрудоустройства : СрокПравило
  +пересчитать(идПатента : Идентификатор, основание : Основание)\n: СводкаСроков
  +зафиксироватьНарушение(идТочки : Идентификатор,\nдатаОбнаружения : Дата)
  +открытьТочку(идПатента : Идентификатор, вид : ВидТочки) :\nКонтрольнаяТочка
  +закрытьТочку(идТочки : Идентификатор, основание : Основание)
  -рассчитатьПлановуюДату(вид : ВидТочки, датаВыдачи : Дата) :\nДата
}

class "СервисНапоминаний" as SRN <<control>> {
  -моментыПоУмолчанию : МоментНапоминания[1..*]
  +настроить(идПрофиля : Идентификатор, каналы :\nКаналУведомления[1..*], моменты : МоментНапоминания[1..*])
  +запланировать(идТочки : Идентификатор, моменты :\nМоментНапоминания[1..*]) : Напоминание[0..*]
  +доставить(напоминание : Напоминание)
  +прекратить(идТочки : Идентификатор)
  +эскалировать(точка : КонтрольнаяТочка)
}

class "ПланировщикЗадач" as PLZ <<control>> {
  -расписание : РасписаниеКонтроля
  +запуститьЕжедневныйКонтроль()
  +отобратьПатентыСКонтролем() : Патент[0..*]
  +передатьВОбработку(идПатента : Идентификатор)
}

class "УведомлениеМВД" as UVM <<entity>> {
  -ид : Идентификатор
  -датаНаправления : Дата
  -канал : КаналУведомления
  -номерКвитанции : НомерДокумента
  -трекНомер : ТрекНомер
  -статус : СтатусУведомления
  +направить(канал : КаналУведомления, подтверждение :\nПодтверждениеОтправки)
  +зафиксироватьДоставку(квитанция : Квитанция)
  +зафиксироватьОшибку(причина : Основание)
  +доказательства() : Документ[1..*]
}

class "КонтрольнаяТочка" as KT <<entity>> {
  -ид : Идентификатор
  -вид : ВидТочки
  -плановаяДата : Дата
  -фактическаяДата : Дата
  -критическая : Признак
  -статус : СтатусТочки
  +просрочена(наДату : Дата) : Признак
  +выполнить(дата : Дата)
  +отметитьНарушение(дата : Дата)
  +отменить(основание : Основание)
}

class "Напоминание" as NAP <<entity>> {
  -ид : Идентификатор
  -датаОтправки : ДатаВремя
  -канал : КаналУведомления
  -текст : ТекстНапоминания
  -статус : СтатусНапоминания
  +отправить(канал : КаналУведомления)
  +отметитьДоставку()
  +отменить()
}

class "ТерриториальныйОрганМВД" as OVD <<entity>> {
  -код : КодОргана
  -наименование : Наименование
  -адрес : Адрес
  +реквизитыАдресата() : РеквизитыАдресата
}

class "РеестрУведомлений" as RU <<repository>> {
  +сохранить(уведомление : УведомлениеМВД) : УведомлениеМВД
  +найти(ид : Идентификатор) : УведомлениеМВД
  +найтиПоДоговору(идДоговора : Идентификатор) : УведомлениеМВД
  +история(идДоговора : Идентификатор) : УведомлениеМВД[0..*]
}

class "ШлюзЕПГУ" as GE <<gateway>> {
  +отправить(уведомление : УведомлениеМВД, подпись : ПодписьЭП) :\nКвитанция
  +проверитьСтатус(номерКвитанции : НомерДокумента) :\nСтатусДоставки
}

class "ШлюзПочты" as GP <<gateway>> {
  +отправить(уведомление : УведомлениеМВД, адресат :\nТерриториальныйОрганМВД) : ТрекНомер
  +сведенияОВозврате(трекНомер : ТрекНомер) : Документ
}

EU ..> SU : 6, 7
EN ..> SRN : 8
PLZ ..> MKS : 9, 10 по расписанию
PLZ ..> SRN : доставка напоминаний
SU ..> UVM : создаёт, меняет статус
SU ..> RU : запись и чтение
SU ..> MKS : закрывает точку
SU ..> GE : канал ЕПГУ
SU ..> GP : канал почта
SU ..> OVD : адресат
SRN ..> NAP : создаёт
SRN ..> MKS : читает сроки
MKS ..> KT : создаёт, закрывает
KT "1" -- "0..*" NAP : напоминания
UVM "0..*" -- "1" OVD : адресат

note right of SU
  Канал — параметр, а не отдельный класс:
  проект уведомления формируется один раз и
  одинаково для ЕПГУ и почты. Шлюзы
  различаются только способом доставки.
end note

note right of MKS
  Правило «2 месяца с даты выдачи патента»
  живёт здесь и не дублируется по сервисам:
  его вызывают операции 1, 4, 6, 9, 10, 14.
end note

note bottom of NAP
  Напоминание не существует без контрольной
  точки (ИНВ-9): создаётся только по открытой
  точке и снимается вместе с её закрытием.
end note

legend bottom left
  <<boundary>> — граничный класс, <<control>> — управляющий класс,
  <<entity>> — сущность лаб. 2, <<repository>> — хранилище,
  <<gateway>> — шлюз к внешней системе (ЕПГУ, Почта России).
  Кратности: 1, 0..1, 1..*, 0..*.
end legend

@enduml
