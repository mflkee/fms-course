@startuml 01-layers
' Лаб. 5: классы проектирования. Обзор слоёв модели (BCE + репозитории + шлюзы)
' Тема 7 «Действия после получения патента». Репозиторий: https://github.com/mflkee/fms-course
' Проверка: plantuml -checkonly 01-layers.puml ; рендер: plantuml -tpng 01-layers.puml

title Лаб. 5. Слои модели проектирования: 26 классов

hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam package {
  BackgroundColor #F4F7FB
  BorderColor #6B7C93
  FontStyle bold
}
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #4A6FA5
  ArrowColor #333333
  HeaderBackgroundColor #EAF0F8
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C9B458
}
skinparam nodesep 20
skinparam ranksep 40
top to bottom direction

package "Границы (boundary) — 4" as P_UI {
  class "ЭкранПатента" as B_PAT <<boundary>>
  class "ЭкранДоговора" as B_DOG <<boundary>>
  class "ЭкранУведомления" as B_UVD <<boundary>>
  class "ЭкранСроков" as B_SROK <<boundary>>
}

package "Управление (control) — 4" as P_CTL {
  class "СервисПатентов" as C_PAT <<control>>
  class "СервисДоговоров" as C_DOG <<control>>
  class "СервисУведомлений" as C_UVD <<control>>
  class "СервисСроков" as C_SROK <<control>>
}

package "Сущности (entity) — 13" as P_ENT {
  class "ИностранныйГражданин" as E_IG <<entity>>
  class "Патент" as E_PAT <<entity>>
  class "Регион" as E_REG <<entity>>
  class "ВидДеятельности" as E_VID <<entity>>
  class "Работодатель" as E_RAB <<entity>>
  class "Договор" as E_DOG <<entity>>
  class "ТрудовойДоговор" as E_TD <<entity>>
  class "ДоговорГПХ" as E_GPX <<entity>>
  class "УведомлениеМВД" as E_UVD <<entity>>
  class "КонтрольнаяТочка" as E_KT <<entity>>
  class "Напоминание" as E_NAP <<entity>>
  class "Документ" as E_DOC <<entity>>
  class "ТерриториальныйОрганМВД" as E_OVD <<entity>>
}

package "Репозитории (repository) — 3" as P_REP {
  class "РепозиторийПатентов" as R_PAT <<repository>>
  class "РепозиторийДоговоров" as R_DOG <<repository>>
  class "РепозиторийУведомлений" as R_UVD <<repository>>
}

package "Шлюзы (gateway) — 2" as P_GW {
  class "ШлюзЕПГУ" as G_EPGU <<gateway>>
  class "ШлюзПочты" as G_POST <<gateway>>
}

B_PAT ..> C_PAT : вызывает
C_PAT ..> E_PAT : создаёт
C_PAT ..> R_PAT : сохраняет
C_DOG ..> E_DOG : создаёт
C_DOG ..> R_DOG : сохраняет
C_UVD ..> E_UVD : создаёт
C_UVD ..> G_EPGU : отправляет
C_SROK ..> E_KT : создаёт
C_SROK ..> R_PAT : сохраняет

R_PAT -[hidden]-> G_EPGU

legend bottom left
  <<boundary>> — экран прецедента (4), <<control>> — сценарий операции (4),
  <<entity>> — сущность предметной области, только атрибуты (13),
  <<repository>> — хранилище агрегата, сохранить и найти (3),
  <<gateway>> — шлюз отправки во внешнюю систему (2).
  Показаны типовые зависимости слоёв; полностью — на диаграммах 02 и 03.
end legend

@enduml
