@startuml 01-layers
' Лаб. 5: классы проектирования. Обзор слоёв модели (BCE + хранилища и шлюзы)
' Тема 7 «Действия после получения патента». Репозиторий: https://github.com/mflkee/fms-course
' Проверка: plantuml -checkonly 01-layers.puml ; рендер: plantuml -tpng 01-layers.puml

title Лаб. 5. Слои модели проектирования (BCE + хранилища и шлюзы)

hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam package {
  BackgroundColor #F4F7FB
  BorderColor #6B7C93
  FontStyle bold
}
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #4A6FA5
  ArrowColor #333333
  HeaderBackgroundColor #EAF0F8
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C9B458
}
skinparam nodesep 25
skinparam ranksep 55
left to right direction

package "Граничный уровень (boundary)" as P_UI {
  class "ЭкранПатента" as EP <<boundary>> {
    -вводимыеДанные : ДанныеПатента
    +ввестиДанные(данные : ДанныеПатента)
    +приложитьСкан(скан : Документ)
    +показатьРезультат(результат : РезультатРегистрацииПатента)
  }
  class "ЭкранПлатежаНДФЛ" as EPL <<boundary>> {
    -вводимыйПлатёж : ДанныеПлатежа
    +ввестиПлатёж(данные : ДанныеПлатежа)
    +приложитьДокумент(документ : Документ)
    +показатьСтатусОплаты(патент : Патент)
  }
}

package "Управляющий уровень (control)" as P_SRV {
  class "СервисПатентов" as SP <<control>> {
    -правилаПроверки : ПравилаПатента
    +зарегистрировать(данныеПатента : ДанныеПатента, скан :\nДокумент) : Патент
    +пометитьАрхивным(идПатента : Идентификатор, причина :\nОснование)
    +выдатьСведения(идПатента : Идентификатор, запрашивающий :\nПользователь) : СведенияОпатенте
  }
  class "СервисНДФЛ" as SN <<control>> {
    -правилоПериодичности : ПравилоОплаты
    +зарегистрироватьПлатёж(идПатента : Идентификатор,\nданныеПлатежа : ДанныеПлатежа) : ПлатёжНДФЛ
    +подтвердить(идПлатежа : Идентификатор, документ : Документ)
    +прекратитьИзЗаНеуплаты(идПатента : Идентификатор,\nдатаПрекращения : Дата)
  }
  class "МодульКонтроляСроков" as MKS <<control>> {
    -срокТрудоустройства : СрокПравило
    +пересчитать(идПатента : Идентификатор, основание : Основание)\n: СводкаСроков
    +зафиксироватьНарушение(идТочки : Идентификатор,\nдатаОбнаружения : Дата)
  }
}

package "Уровень сущностей (entity)" as P_ENT {
  class "Патент" as PAT <<entity>> {
    -ид : Идентификатор
    -датаВыдачи : Дата
    -датаТрудоустройстваНеПозднее : Дата
    -оплаченДо : Дата
    -статус : СтатусПатента
    +действует(наДату : Дата) : Признак
    +рассчитатьСроки() : СрокиПатента
    +отметитьОплату(до : Дата)
  }
  class "ПлатёжНДФЛ" as PLT <<entity>> {
    -ид : Идентификатор
    -период : Период
    -сумма : Сумма
    -статус : СтатусПлатежа
    +соответствуетСумме(стоимость : Сумма) : Признак
    +подтвердить(документ : Документ, источник :\nИсточникПодтверждения)
  }
  class "Регион" as REG <<entity>> {
    -код : КодРегиона
    -наименование : Наименование
    -стоимостьПатента : Сумма
    +стоимостьНаДату(дата : Дата) : Сумма
  }
}

package "Уровень хранилищ и справочников (repository)" as P_REP {
  class "РеестрПатентов" as REP <<repository>> {
    +сохранить(патент : Патент) : Патент
    +найти(ид : Идентификатор) : Патент
    +найтиДействующий(идИГ : Идентификатор) : Патент
  }
  class "СправочникРегионов" as SR <<repository>> {
    +найти(код : КодРегиона) : Регион
    +актуальныеНа(дата : Дата) : Регион[1..*]
  }
}

package "Уровень шлюзов (gateway)" as P_GW {
  class "ШлюзФНС" as GF <<gateway>> {
    +запроситьСостояниеРасчётов(инн : ИНН, период : Период) :\nСостояниеРасчётов
    +передатьСведения(платёж : ПлатёжНДФЛ)
  }
}

EP ..> SP : 1 зарегистрироватьПатент
EPL ..> SN : 11, 12 платёж
SP ..> MKS : рассчитать сроки
SN ..> MKS : пересчитать сроки
SP ..> REP : запись и чтение
SN ..> PLT : создаёт
SP ..> PAT : создаёт
SN ..> GF : сверка расчётов
SR ..> REG : поставляет
PAT "1" -- "1" REG : регион выдачи

note bottom of P_UI
  Границы знают только управляющий уровень:
  ни сущности, ни хранилища им не видны.
end note

note bottom of P_GW
  Шлюз — единственное место, где модель
  соприкасается с внешней системой (ФНС).
  Протокол обмена в модели не раскрывается.
end note

P_UI -[hidden]-> P_SRV
P_SRV -[hidden]-> P_ENT
P_ENT -[hidden]-> P_REP
P_REP -[hidden]-> P_GW

legend bottom left
  <<boundary>> — граничный класс (экран), <<control>> — управляющий класс,
  <<entity>> — сущность предметной области (лаб. 2),
  <<repository>> — хранилище или справочник,
  <<gateway>> — шлюз к внешней системе.
  Кратности — по UML: 1, 0..1, 1..*, 0..*.
end legend

@enduml
