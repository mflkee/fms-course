@startuml 02-patent-dogovor
' Лаб. 5: классы проектирования. Патенты и договоры
' Тема 7 «Действия после получения патента». Репозиторий: https://github.com/mflkee/fms-course
' Проверка: plantuml -checkonly 02-patent-dogovor.puml ; рендер: plantuml -tpng 02-patent-dogovor.puml

title Лаб. 5. Патенты и договоры (операции 1–5, 14)

hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #4A6FA5
  ArrowColor #333333
  HeaderBackgroundColor #EAF0F8
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C9B458
}
skinparam nodesep 22
skinparam ranksep 45
top to bottom direction

class "ЭкранПатента" as EP <<boundary>> {
  -вводимыеДанные : ДанныеПатента
  -скан : Документ
  +ввестиДанные(данные : ДанныеПатента)
  +приложитьСкан(скан : Документ)
  +запроситьСведения(идПатента : Идентификатор)
  +подтвердитьАрхивацию(идПатента : Идентификатор, причина :\nОснование)
  +показатьРезультат(результат : РезультатРегистрацииПатента)
}

class "ЭкранДоговора" as ED <<boundary>> {
  -данныеДоговора : ДанныеДоговора
  +ввестиДанные(идПатента : Идентификатор, данные :\nДанныеДоговора)
  +приложитьФайл(файл : Документ)
  +показатьПроект(проект : ПроектДоговора)
  +подтвердитьЗаключение()
  +указатьПричинуОтмены(причина : Основание)
  +указатьПрекращение(дата : Дата, основание : Основание)
}

class "СервисПатентов" as SP <<control>> {
  -правилаПроверки : ПравилаПатента
  +зарегистрировать(данныеПатента : ДанныеПатента, скан :\nДокумент) : Патент
  +пометитьАрхивным(идПатента : Идентификатор, причина :\nОснование)
  +выдатьСведения(идПатента : Идентификатор, запрашивающий :\nПользователь) : СведенияОпатенте
  -проверитьРеквизиты(данные : ДанныеПатента) :\nОшибкиВалидации[0..*]
  -проверитьЕдинственность(идИГ : Идентификатор) : Признак
}

class "СервисДоговоров" as SD <<control>> {
  -правилаПроверки : ПравилаДоговора
  +заключить(идПатента : Идентификатор, данныеДоговора :\nДанныеДоговора, документ : Документ) : Договор
  +отменить(идДоговора : Идентификатор, причина : Основание)
  +прекратить(идДоговора : Идентификатор, датаПрекращения : Дата,\nдокумент : Документ)
  -проверитьДопустимостьПрофессии(данные : ДанныеДоговора, патент\n: Патент) : Признак
  -проверитьОтсутствиеДействующего(идПатента : Идентификатор) :\nПризнак
}

class "ИностранныйГражданин" as IG <<entity>> {
  -ид : Идентификатор
  -фио : ФИО
  -датаРождения : Дата
  -гражданство : Гражданство
  -статус : СтатусИГ
  +действующийПатент(наДату : Дата) : Патент
  +патентПо(серияНомер : НомерДокумента) : Патент
}

class "Патент" as PAT <<entity>> {
  -ид : Идентификатор
  -серияНомер : НомерДокумента
  -датаВыдачи : Дата
  -срокДействия : Дата
  -датаТрудоустройстваНеПозднее : Дата
  -оплаченДо : Дата
  -статус : СтатусПатента
  +действует(наДату : Дата) : Признак
  +рассчитатьСроки() : СрокиПатента
  +допускаетПрофессию(вид : ВидДеятельности) : Признак
  +архивировать(причина : Основание)
  +отметитьОплату(до : Дата)
}

class "Работодатель" as RAB <<entity>> {
  -ид : Идентификатор
  -наименование : Наименование
  -инн : ИНН
  -тип : ТипОрганизации
  -контактноеЛицо : ФИО
  +действующиеДоговоры() : Договор[0..*]
}

class "Договор" as DOG <<entity>> {
  -ид : Идентификатор
  -номер : НомерДокумента
  -вид : ВидДоговора
  -датаЗаключения : Дата
  -датаОкончания : Дата
  -статус : СтатусДоговора
  +заключить(дата : Дата)
  +прекратить(дата : Дата, основание : Основание)
  +действует(наДату : Дата) : Признак
}

class "ТрудовойДоговор" as TD <<entity>> {
  -должность : Должность
  -режим : РежимРаботы
  +условияТруда() : УсловияТруда
}

class "ДоговорГПХ" as GPX <<entity>> {
  -предмет : ПредметРабот
  -срокРабот : Дата
  +объёмРабот() : ПредметРабот
}

class "ВидДеятельности" as VID <<entity>> {
  -код : КодВидаДеятельности
  -наименование : Наименование
  -допустимДляПатента : Признак
  +допустимКПрименению() : Признак
}

class "СправочникВидовДеятельности" as SV <<repository>> {
  +найти(код : КодВидаДеятельности) : ВидДеятельности
  +допустимыеДляПатента() : ВидДеятельности[1..*]
}

class "РеестрПатентов" as REP <<repository>> {
  +сохранить(патент : Патент) : Патент
  +найти(ид : Идентификатор) : Патент
  +найтиДействующий(идИГ : Идентификатор) : Патент
  +найтиПоРеквизитам(серияНомер : НомерДокумента) : Патент
}

class "РеестрДоговоров" as RD <<repository>> {
  +сохранить(договор : Договор) : Договор
  +найти(ид : Идентификатор) : Договор
  +найтиДействующий(идПатента : Идентификатор) : Договор
  +найтиПоРаботодателю(идРаботодателя : Идентификатор) :\nДоговор[0..*]
}

EP ..> SP : 1–3
ED ..> SD : 4, 5, 14
SP ..> PAT : создаёт, архивирует
SP ..> REP : запись и чтение
SP ..> SV : проверяет профессию
SD ..> DOG : создаёт, прекращает
SD ..> RD : запись и чтение
SD ..> REP : читает патент
SD ..> SV : проверяет профессию
SD ..> PAT : проверяет срок и профессию
IG "1" -- "0..*" PAT : владеет
PAT "1" -- "0..1" DOG : действующий договор
PAT "1" -- "1..*" VID : профессии в патенте
SV "1" ..> "0..*" VID : поставляет
RAB "1" -- "0..*" DOG : заключает
DOG <|-- TD
DOG <|-- GPX

note right of SP
  Проверки ИНВ-6 (один действующий патент)
  и ИНВ-4 (профессия) — внутри сервиса,
  а не в экране: правило должно действовать
  при любом способе вызова.
end note

note right of SD
  ИНВ-1: перед заключением запрашивается
  действующий договор по патенту.
  ИНВ-3: дата заключения сравнивается
  с датой трудоустройства не позднее.
  Просрочка не блокирует (операция 4).
end note

note bottom of DOG
  Абстрактный класс: общие реквизиты и статус.
  Различие форм — в подклассах; от вида зависит
  задача уведомления МВД и порядок НДФЛ.
end note

legend bottom left
  <<boundary>> — граничный класс, <<control>> — управляющий класс,
  <<entity>> — сущность лаб. 2, <<repository>> — хранилище.
  Кратности: 1, 0..1, 1..*, 0..*.
end legend

@enduml
