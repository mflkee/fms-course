@startuml class-diagram
' Лаб. 2: модель предметной области темы 7 (пункты 7.1 и 7.2).
' Только атрибуты; без id, методов и модификаторов доступа.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
}
skinparam ArrowColor #333333

class ИностранныйГражданин {
  фио
  гражданство
  документЛичности
  телефон
}

class Патент {
  серия
  номер
  датаВыдачи
  срокДействия
  регион
  профессия
  статус
}

class Работодатель {
  наименование
  инн
  тип
}

abstract class Договор {
  номер
  датаЗаключения
  датаОкончания
  статус
}
class ТрудовойДоговор {
  должность
  режим
}
class ДоговорГПХ {
  предмет
  срокРабот
}
Договор <|-- ТрудовойДоговор
Договор <|-- ДоговорГПХ

class УведомлениеМВД {
  датаНаправления
  канал
  номерКвитанции
  трекНомер
  статус
}

class КонтрольнаяТочка {
  вид
  плановаяДата
  фактическаяДата
  статус
}

class Напоминание {
  датаПоказа
  статус
}

class Документ {
  тип
  имяФайла
  датаЗагрузки
}

ИностранныйГражданин "1" --> "0..*" Патент : имеет
Патент "1" --> "0..1" Договор : действующий договор
Работодатель "1" --> "0..*" Договор : заключает
Договор "1" --> "0..1" УведомлениеМВД : по договору
Патент "1" *-- "0..*" КонтрольнаяТочка : сроки
КонтрольнаяТочка "1" --> "0..*" Напоминание : предупреждения
Патент "1" o-- "0..*" Документ : скан
Договор "1" o-- "0..*" Документ : файл
УведомлениеМВД "1" o-- "0..*" Документ : копия и квитанция
@enduml
