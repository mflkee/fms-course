@startuml class-diagram
' Диаграмма классов предметной области: «Действия после получения патента» (тема 7 дорожной карты)
' Рендер: plantuml class-diagram.puml
' Проверка: plantuml -checkonly class-diagram.puml

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
  ArrowColor #333333
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C9B458
}

' --- участники ---
class ИностранныйГражданин {
  + ид : UUID
  + фио : String
  + датаРождения : Date
  + гражданство : String
  + документЛичности : String
  + инн : String
  + адресПребывания : String
  + телефон : String
  + email : String
  + статус : СтатусИГ
}

class Патент {
  + ид : UUID
  + серия : String
  + номер : String
  + датаВыдачи : Date
  + срокДействия : Date
  + оплаченДо : Date
  + органВыдавший : String
  + статус : СтатусПатента
}

class Работодатель {
  + ид : UUID
  + наименование : String
  + инн : String
  + огрн : String
  + адрес : String
  + тип : ТипОрганизации
  + контактноеЛицо : String
}

' --- договоры ---
abstract class Договор {
  + ид : UUID
  + номер : String
  + вид : ВидДоговора
  + датаЗаключения : Date
  + датаОкончания : Date
  + статус : СтатусДоговора
}
class ТрудовойДоговор {
  + должность : String
  + режим : РежимРаботы
}
class ДоговорГПХ {
  + предмет : String
  + срокРабот : Date
}
Договор <|-- ТрудовойДоговор
Договор <|-- ДоговорГПХ

class УведомлениеМВД {
  + ид : UUID
  + датаНаправления : Date
  + канал : КаналУведомления
  + номерКвитанции : String
  + трекНомер : String
  + копияДоговора : boolean
  + статус : СтатусУведомления
}

class ПлатёжНДФЛ {
  + ид : UUID
  + датаПлатежа : Date
  + сумма : Money
  + период : String
  + документНомер : String
  + статус : СтатусПлатежа
}

class КонтрольнаяТочка {
  + ид : UUID
  + вид : ВидТочки
  + плановаяДата : Date
  + фактическаяДата : Date
  + критическая : boolean
  + статус : СтатусТочки
}

class Напоминание {
  + ид : UUID
  + датаОтправки : Date
  + канал : КаналУведомления
  + текст : String
  + статус : СтатусНапоминания
}

class Регион {
  + код : String
  + наименование : String
  + стоимостьПатента : Money
  + датаАктуальности : Date
}

class ВидДеятельности {
  + код : String
  + наименование : String
  + допустимДляПатента : boolean
}

class Документ {
  + ид : UUID
  + тип : ТипДокумента
  + имяФайла : String
  + хэш : String
  + датаЗагрузки : Date
  + источник : String
}

class ТерриториальныйОрганМВД {
  + код : String
  + наименование : String
  + адрес : String
}

' --- пользователи ---
abstract class Пользователь {
  + ид : UUID
  + логин : String
  + контакт : String
  + активен : boolean
}
class ПользовательИГ {
  + предпочитаемыйКанал : КаналУведомления
}
class ПредставительРаботодателя {
  + должность : String
}
class АдминистраторСистемы {
  + правоВыгрузки : boolean
}
Пользователь <|-- ПользовательИГ
Пользователь <|-- ПредставительРаботодателя
Пользователь <|-- АдминистраторСистемы

' --- связи ---
ИностранныйГражданин "1" --> "0..*" Патент : имеет
Регион "1" --> "0..*" Патент : регион выдачи
ВидДеятельности "1" --> "0..*" Патент : профессия в патенте

Патент "1" --> "0..1" Договор : действующий договор
Работодатель "1" --> "0..*" Договор : заключает
Договор "0..*" --> "0..1" ВидДеятельности : должность / вид работ

Договор "1" --> "0..1" УведомлениеМВД : уведомление по договору
УведомлениеМВД "0..*" --> "1" ТерриториальныйОрганМВД : адресат
ТерриториальныйОрганМВД "0..*" --> "1" Регион : находится в

Патент "1" *-- "2..*" КонтрольнаяТочка : контрольные точки
КонтрольнаяТочка "1" --> "0..*" Напоминание : напоминания
Патент "1" o-- "0..*" ПлатёжНДФЛ : авансовые платежи

Патент "1" o-- "0..*" Документ : скан патента
Договор "1" o-- "1..*" Документ : файл договора
УведомлениеМВД "1" o-- "1..*" Документ : копия договора и квитанция

ИностранныйГражданин "1" --> "0..1" Пользователь : личный кабинет
Работодатель "1" --> "0..*" Пользователь : представители

note right of Патент
  Инварианты:
  ИНВ-1: не более одного
  действующего договора
  ИНВ-4/5: оплата НДФЛ
  непрерывна
end note

note bottom of КонтрольнаяТочка
  ИНВ-2/3: срок «2 месяца
  с даты выдачи патента»
end note

@enduml
