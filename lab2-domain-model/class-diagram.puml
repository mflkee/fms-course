@startuml class-diagram
' Диаграмма классов предметной области: «Действия после получения патента» (тема 7 дорожной карты)
' Состав и кратности — по DESIGN.md, раздел 5.
' Рендер: plantuml -tpng class-diagram.puml
' Проверка: plantuml -checkonly class-diagram.puml

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
  ArrowColor #333333
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C9B458
}

' --- участники и патент ---
class ИностранныйГражданин {
  фио : String
  датаРождения : Date
  гражданство : String
  документЛичности : String
  инн : String
  адресПребывания : String
  телефон : String
  email : String
  статус : СтатусИГ
}

class Патент {
  серия : String
  номер : String
  датаВыдачи : Date
  срокДействия : Date
  органВыдавший : String
  статус : СтатусПатента
}

class Регион {
  код : String
  наименование : String
}

class ВидДеятельности {
  код : String
  наименование : String
}

class Работодатель {
  наименование : String
  инн : String
  огрн : String
  адрес : String
  тип : ТипОрганизации
  контактноеЛицо : String
}

' --- договоры ---
abstract class Договор {
  номер : String
  вид: ВидДоговора
  датаЗаключения : Date
  датаОкончания : Date
  статус : СтатусДоговора
}
class ТрудовойДоговор {
  должность : String
  режим : РежимРаботы
}
class ДоговорГПХ {
  предмет : String
  срокРабот : Date
}
Договор <|-- ТрудовойДоговор
Договор <|-- ДоговорГПХ

class УведомлениеМВД {
  датаНаправления : Date
  канал : КаналУведомления
  номерКвитанции : String
  трекНомер : String
  статус : СтатусУведомления
}

class ТерриториальныйОрганМВД {
  код : String
  наименование : String
  адрес : String
}

' --- сроки ---
class КонтрольнаяТочка {
  вид: ВидТочки
  плановаяДата : Date
  фактическаяДата : Date
  критическая : boolean
  статус : СтатусТочки
}

class Напоминание {
  датаОтправки : Date
  канал : КаналУведомления
  текст : String
  статус : СтатусНапоминания
}

' --- документы ---
class Документ {
  тип : ТипДокумента
  имяФайла : String
  хэш : String
  датаЗагрузки : Date
  источник : String
}

' --- связи (кратности — окончательные, DESIGN.md §5) ---
ИностранныйГражданин "1" --> "0..*" Патент : имеет
Регион "1" --> "0..*" Патент : регион выдачи
ВидДеятельности "1" --> "0..*" Патент : профессия в патенте

Патент "1" --> "0..1" Договор : действующий договор
Работодатель "1" --> "0..*" Договор : заключает
Договор "0..*" --> "0..1" ВидДеятельности : профессия

Договор "1" --> "0..1" УведомлениеМВД : уведомление по договору
УведомлениеМВД "0..*" --> "1" ТерриториальныйОрганМВД : адресат
ТерриториальныйОрганМВД "0..*" --> "1" Регион : находится в

Патент "1" *-- "0..*" КонтрольнаяТочка : контрольные точки
КонтрольнаяТочка "1" --> "0..*" Напоминание : напоминания

Патент "1" o-- "0..*" Документ : скан патента
Договор "1" o-- "0..*" Документ : файл договора
УведомлениеМВД "1" o-- "0..*" Документ : копия договора и квитанция

note right of Патент
  ИНВ-1: не более одного
  действующего договора
  ИНВ-3: договор не позднее
  2 месяцев с даты выдачи
  ИНВ-5: не более одного
  действующего патента
end note

note bottom of Договор
  ИНВ-4: профессия
  соответствует патенту
end note

note right of УведомлениеМВД
  ИНВ-2: не ранее договора
  и не позднее 2 месяцев
  ИНВ-7: смена работодателя —
  новое уведомление
end note

note bottom of КонтрольнаяТочка
  ИНВ-6: контрольные точки —
  композиция патента
end note

@enduml
