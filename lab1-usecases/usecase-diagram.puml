@startuml usecase-diagram
' Лаб. 1: диаграмма прецедентов. Один актор, два прецедента.
' Границу системы не рисуем: прецедентов вне системы нет.
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam defaultFontSize 18
skinparam usecase {
  BackgroundColor #F4F8FF
  BorderColor #4A6FA5
}

actor "Иностранный\nгражданин" as IG

usecase "П1. Заполнение анкеты" as P1
usecase "П2. Просмотр\nдорожной карты" as P2

IG --> P1
IG --> P2
@enduml
