@startuml usecase-diagram
' Диаграмма прецедентов: подсистема «Действия после получения патента» (тема 7 дорожной карты)
' 4 прецедента (П01–П04), 4 актора (A1–A4). Отношений include/extend нет:
' прецеденты независимы, связь между ними — только через предусловия (см. usecase-diagram.md).
' Рендер: plantuml usecase-diagram.puml   (или расширение PlantUML в IDE)
' Проверка: plantuml -checkonly usecase-diagram.puml

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam nodesep 34
skinparam ranksep 70
skinparam usecase {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

' --- Основные исполнители ---
actor "Иностранный\nгражданин (ИГ)" as CIT
actor "Работодатель /\nзаказчик по ГПХ" as EMP

' --- Вспомогательные исполнители ---
actor "Сотрудник ОВМ МВД\n(территориальный орган)" as MVD
actor "ЕПГУ /\nПочта России" as CHANNEL

rectangle "Подсистема «Действия после получения патента»" as SYS {
  usecase "П01. Учесть\nвыданный патент" as UC01
  usecase "П02. Заключить трудовой договор\nили договор ГПХ (7.1)" as UC02
  usecase "П03. Уведомить МВД\nоб осуществлении\nтрудовой деятельности (7.2)" as UC03
  usecase "П04. Контролировать срок\nтрудоустройства\nи напоминать" as UC04
}

' --- ассоциации ---
CIT --> UC01
CIT --> UC02
CIT --> UC04

EMP --> UC02
EMP --> UC03
EMP --> UC04

MVD --> UC03
CHANNEL --> UC03

@enduml
