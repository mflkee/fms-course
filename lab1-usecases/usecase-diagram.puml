@startuml usecase-diagram
' Лаб. 1: диаграмма прецедентов. Один актор, два прецедента.
' Граница системы: система только собирает анкету и показывает дорожную карту.
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F4F8FF
  BorderColor #4A6FA5
}

actor "Иностранный\nгражданин" as IG

rectangle "Система «Дорожная карта»" {
  usecase "П1. Заполнить анкету" as P1
  usecase "П2. Просмотреть\nдорожную карту" as P2
}

IG --> P1
IG --> P2
@enduml
