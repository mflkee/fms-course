@startuml 07-zafiksirovat-vozvrat-uvedomleniya
' Лаб. 4: диаграмма коммуникаций (взаимодействие объектов)
' Системная операция: зафиксироватьВозвратУведомления() — прецедент П03
' Проверка: plantuml -checkonly 07-zafiksirovat-vozvrat-uvedomleniya.puml ; рендер: plantuml -tpng 07-zafiksirovat-vozvrat-uvedomleniya.puml
' Репозиторий: https://github.com/mflkee/fms-course

title Лаб. 4. Операция зафиксироватьВозвратУведомления()
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam object {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
  ArrowColor #333333
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C9B458
}
skinparam nodesep 20
skinparam ranksep 40

object "Почта России (A5)" as POST <<актор>>
object "СервисУведомлений" as SU <<компонент>>
object "РеестрПатентов" as REP <<хранилище>>
object "УведомлениеМВД" as UVD
object "Документ (возврат отправления)" as DOC
object "МодульКонтроляСроков" as MKS <<компонент>>
object "КонтрольнаяТочка" as KT
object "СервисНапоминаний" as SRN <<компонент>>
object "Иностранный гражданин (A1)" as CIT <<актор>>
object "ЖурналАудита" as AUD <<компонент>>

POST --> SU : 1. зафиксироватьВозвратУведомления(идУведомления, причина =\n«истёк срок хранения»)
SU --> REP : 1.1 найтиУведомление(идУведомления)
REP ..> SU : 1.2 УведомлениеМВД{канал = «почта», трекНомер, статус =\n«направлено»}
SU --> UVD : 1.3 зафиксироватьНеудачнуюПопытку(причина, номерПопытки)
SU --> DOC : 1.4 сохранитьДоказательство(возврат, причина)
SU --> MKS : 1.5 пересчитатьОстатокСрока(идТочки)
MKS --> KT : 1.6 установитьСтатус(«критическая») /\nустановитьСтатус(«просрочена»)
SU --> SRN : 1.7 эскалировать(обеСтороны, инойКанал)
SRN --> CIT : 1.8 предупреждение(«уведомление не доставлено», остатокСрока,\nриск)
SU --> REP : 1.9 сохранить(уведомление, документ)
SU --> AUD : 1.10 записатьСобытие(«возврат отправления уведомления»,\nпричина)
SU ..> POST : 2. УведомлениеМВД{статус = «ошибка», номерПопытки = 2}

legend bottom left
  <<компонент>> — концептуальный компонент подсистемы, <<хранилище>> — хранилище учётных сущностей,
  <<справочник>> — справочник, <<актор>> — действующее лицо лаб. 1,
  без стереотипа — объект предметной области из лаб. 2.
  Нумерация сообщений — UML (1, 1.1, 1.2, 2, …); пунктир — возврат данных и управления.
end legend

@enduml